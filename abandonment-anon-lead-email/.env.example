# Supabase (read-only access is sufficient — this worker performs zero writes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Brevo transactional email — anon-lead template (params contract = template 39)
BREVO_API_KEY=your-brevo-api-key
BREVO_TEMPLATE_ID_ANON_LEAD=

# Anthropic (match pitch generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Base URL for the /your-match landing page
STANDOUT_APP_URL=https://www.usestandout.today

# HMAC secret for the lead token. MUST match the main app's EMAIL_LINK_SECRET —
# without it the landing page cannot resolve the lead, and leads are skipped.
EMAIL_LINK_SECRET=

# Safety switch: keep true until you are ready for live sends.
# When true: logs payloads, makes NO Brevo calls, does NOT touch KV.
DRY_RUN=true

# --- One-time backfill (leave both UNSET for normal operation) --------------
# BACKFILL_DAYS: widens the survey window from [now-2h, now-1h] to
# [now-N days, now-1h] so past abandoners are reachable. Integer 1–30 (out of
# range is clamped, anything invalid falls back to the normal window).
# BACKFILL_DAYS=14
#
# SEND_CAP: max real sends per run. Defaults to 50 in backfill mode and to no
# cap in normal mode. The rest is deferred to the next hourly run; the KV
# sent-tracker is what stops anyone being mailed twice.
# SEND_CAP=50

# Vercel KV — send-once dedup (anon_lead_sent:<email>).
#
# REQUIRED on Vercel. Without it dedup falls back to an in-process Set that
# every serverless instance and cold start wipes, so the worker FAILS CLOSED: a
# real send (DRY_RUN=false) from any Vercel deployment — production or preview —
# throws before it queries Supabase, rather than silently re-mailing the same
# leads every hour.
#
# Optional locally: dry runs anywhere, and real sends off Vercel, log a
# NON-DURABLE banner and cap the run at 50 sends instead of refusing.
KV_REST_API_URL=
KV_REST_API_TOKEN=
