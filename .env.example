# standout-email-workers — environment
#
# Copy to .env for local runs (`cp .env.example .env`). In production every one
# of these is set under Vercel → Project → Settings → Environment Variables.
# .env* is gitignored except this file — never commit real values.

# ---------------------------------------------------------------------------
# Supabase (service role — bypasses RLS, which is required: profiles,
# marketing_suppressions and pending_subscriptions are all service-role-only)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Brevo transactional email
# ---------------------------------------------------------------------------
# BREVO_KEY is accepted as a legacy alias for BREVO_API_KEY.
BREVO_API_KEY=your-brevo-api-key
# Email 1 — "here's your best match" (1–24h after signup).
BREVO_TEMPLATE_ID=39
# Email 2 — 24h loss-aversion nurture. NO DEFAULT: the worker refuses to start
# without it. (It used to fall back to a hardcoded `40`, which is how you mail
# the wrong template to real users when an env var goes missing.)
BREVO_TEMPLATE_ID_2=

# ---------------------------------------------------------------------------
# Anthropic — email 1 "why you match" bullet generation (Claude Haiku).
# Optional: unset means email 1 falls back to deterministic non-AI copy.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---------------------------------------------------------------------------
# Links
# ---------------------------------------------------------------------------
# Canonical app origin. Trailing slashes are trimmed. Default if unset:
# https://www.usestandout.today  (standout.jobs is dead — do not use it).
STANDOUT_APP_URL=https://www.usestandout.today
# Shared with the product's server/lib/email-token.ts. Signs the auto-login
# magic links so recipients land signed-in. If unset, links degrade gracefully
# to plain (non-authenticating) URLs.
EMAIL_LINK_SECRET=your-email-link-secret

# ---------------------------------------------------------------------------
# Cron authentication (REQUIRED)
# ---------------------------------------------------------------------------
# Set this in Vercel project settings. Vercel Cron then sends it on every
# scheduled invocation as `Authorization: Bearer $CRON_SECRET`, and both
# /api/* routes reject anything else. If it is unset the routes fail CLOSED
# (HTTP 500) rather than running unauthenticated.
CRON_SECRET=a-long-random-string

# ---------------------------------------------------------------------------
# Vercel KV — LEGACY / TRANSITION ONLY
# ---------------------------------------------------------------------------
# Dedup lives in Postgres now (profiles.abandonment_email_1_sent_at etc).
# These are read by abandonment-job-email/sent-tracker.js purely so users
# emailed BEFORE those columns existed don't get a second copy of email 1.
# Safe to delete, along with sent-tracker.js, after ~2026-08-01.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Safety switch
# ---------------------------------------------------------------------------
# STRICT parsing: exactly "true" or "false".
#   true    -> log only; no Brevo calls, no Anthropic calls, no DB writes
#   false   -> live sends
#   unset   -> treated as true, with a warning
#   other   -> the run throws (a typo must never masquerade as a live send)
DRY_RUN=true
